#!/usr/bin/env bash
# docview [目录]                               在当前窗格打开开始页，从当前目录（或指定目录）选择文件
# docview <飞书文档URL | file.md | file.html>   在当前窗格直接打开文档
# docview --pane [目录 | 文档]                  在 herdr 右侧新开窗格打开（不抢焦点，退出后窗格自动关闭）
# docview --refresh                            让本 workspace 里运行中的 docview 立即重新加载（供 agent 调用）
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

die() { echo "docview: $*" >&2; exit 1; }
usage() { sed -n '2,5p' "$0" | sed 's/^# //'; }

# Each running viewer owns one target file, named per workspace and pane, so that
# `--refresh` from another pane (e.g. the agent's) can reach every viewer in the workspace.
ws="${HERDR_WORKSPACE_ID:-local}"
state="$HOME/.local/state/docview"
mkdir -p "$state"

# resolve_target <arg>: validate and print the target (URL, or absolute dir/file path).
resolve_target() {
  local t="$1"
  case "$t" in
  http://* | https://*) ;;
  *)
    if [ -d "$t" ]; then
      t="$(cd "$t" && pwd)"
    else
      [ -f "$t" ] || die "文件不存在: $t"
      case "${t##*.}" in
      md | markdown | html | htm) ;;
      *) die "只支持 .md/.markdown/.html/.htm 文件: $t" ;;
      esac
      t="$(cd "$(dirname "$t")" && pwd)/$(basename "$t")"
    fi
    ;;
  esac
  printf '%s\n' "$t"
}

case "${1:-}" in
-h | --help)
  usage
  ;;
--refresh)
  shopt -s nullglob
  files=("$state/$ws".*.target)
  [ ${#files[@]} -gt 0 ] || die "当前 workspace 没有运行中的 docview"
  touch "${files[@]}"
  echo "refresh requested (${#files[@]} viewer)"
  ;;
--pane)
  [ "${HERDR_ENV:-}" = 1 ] || die "--pane 需要在 herdr 的窗格里运行"
  t="$(resolve_target "${2:-$PWD}")"
  id=$(herdr pane split --current --direction right --cwd "$PWD" --no-focus | jq -r '.result.pane.pane_id // empty')
  [ -n "$id" ] || die "新建窗格失败"
  # Single-quote both args for the pane's shell (keeps CJK and spaces intact). `&& exit`
  # closes the pane when docview quits normally, but keeps it open to show an error.
  q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
  herdr pane run "$id" "$(q "$(realpath "$0")") $(q "$t") && exit" >/dev/null ||
    { herdr pane close "$id" >/dev/null; die "在新窗格中启动 docview 失败"; }
  echo "opened $t in $id"
  ;;
*)
  t="$(resolve_target "${1:-$PWD}")"
  target_file="$state/$ws.${HERDR_PANE_ID:-pid$$}.target"
  printf '%s\n' "$t" >"$target_file"
  export DOCVIEW_TARGET_FILE="$target_file"
  # uv installs and caches the Python deps declared at the top of docview.py. Exec that
  # env's python directly instead of `uv run`, so uv doesn't stay resident (~20 MB each).
  script="$(dirname "$(realpath "$0")")/../docview.py"
  # --locked: install exactly the versions in docview.py.lock; fail instead of upgrading.
  uv sync --quiet --locked --script "$script"
  exec "$(uv python find --script "$script")" "$script"
  ;;
esac
